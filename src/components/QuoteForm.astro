---
/* The estimate request: two short steps, then a real result. It posts JSON to
   CAMP's own lead intake in WordPress (/wp-json/cmp/v1/leads, Sarah's system),
   so a request lands where the office already works, and only shows success
   when that answers OK. The intake is same origin only, so it sends on
   camplandscape.com; anywhere else (the preview) or on any failure it says so
   and gives the phone number, because a form that pretends to send is how
   leads get lost.

   The intake takes one service from a fixed list, so the first service picked
   decides it (by its group) and every pick, the property, town, message and
   page go in notes. No file uploads, so photos go by text. */
import { BRAND, LEADS } from '../data/site';
import { SERVICES } from '../data/services';
import { CITIES } from '../data/cities';
import { href } from '../lib/paths';

interface Props {
  service?: string;
  town?: string;
  /** Which property type starts selected: 0 home, 1 business, 2 community. */
  kind?: number;
}
const { service = '', town = '', kind = 0 } = Astro.props;
const id = 'qf';
const names = CITIES.map((c) => c.name);
const common = ['Landscape management', 'Landscape installation', 'Irrigation installation', 'Irrigation service and repair', 'Snow and ice removal', 'Retaining walls and steps', 'Sod, seed and grading', 'Fertilizer and weed control', 'Sprinkler winterization'];
const KINDS = ['A home', 'A business or office', 'An apartment community or HOA'];
/* Service name to the intake's service value, by the service's group. */
const BY_GROUP = { build: 'Landscaping', care: 'Lawn Maintenance', water: 'Irrigation', winter: 'Snow/Ice Management' } as const;
const intake: Record<string, string> = {};
for (const s of SERVICES) intake[s.name] = BY_GROUP[s.group as keyof typeof BY_GROUP] ?? 'Other';
for (const c of common) if (!intake[c]) intake[c] = /irrigation|sprinkler/i.test(c) ? 'Irrigation' : /snow/i.test(c) ? 'Snow/Ice Management' : /management|fertilizer|weed/i.test(c) ? 'Lawn Maintenance' : 'Landscaping';
---

<form class="qf" id={id} action={LEADS.endpoint} method="POST" data-host={LEADS.host} data-thanks={href('/thank-you/')} data-tel={BRAND.phoneHref} data-phone={BRAND.phone} data-intake={JSON.stringify(intake)}>
  <input type="checkbox" name="botcheck" class="sr" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <noscript><p class="small">This form needs JavaScript. Call or text us at <a href={BRAND.phoneHref}>{BRAND.phone}</a> instead.</p></noscript>

  <fieldset class="qf__step" data-step="1">
    <legend class="qf__legend"><span class="fine muted">Step 1 of 2</span> What do you need?</legend>
    <div class="qf__kind" role="radiogroup" aria-label="What kind of property">
      {
        KINDS.map((k, i) => (
          <label class="qf__chip">
            <input type="radio" name="property_type" value={k} checked={i === kind} />
            <span>{k}</span>
          </label>
        ))
      }
    </div>
    <ul class="qf__chips">
      {
        common.map((c) => (
          <li>
            <label class="qf__chip">
              <input type="checkbox" name="services" value={c} checked={c === service} />
              <span>{c}</span>
            </label>
          </li>
        ))
      }
    </ul>
    <label class="qf__field">
      <span>Something else?</span>
      <select name="other_service">
        <option value="">Choose a service</option>
        {SERVICES.filter((s) => !common.includes(s.name)).map((s) => <option selected={s.name === service}>{s.name}</option>)}
      </select>
    </label>
    <label class="qf__field">
      <span>Town</span>
      <input name="town" list="qf-towns" autocomplete="address-level2" placeholder="Where is the property?" value={town} />
      <datalist id="qf-towns">{names.map((n) => <option value={n} />)}</datalist>
    </label>
    <button class="btn primary qf__next" type="button">Next</button>
  </fieldset>

  <fieldset class="qf__step" data-step="2">
    <legend class="qf__legend"><span class="fine muted">Step 2 of 2</span> How do we reach you?</legend>
    <label class="qf__field"><span>Name</span><input name="name" required autocomplete="name" /></label>
    <div class="qf__two">
      <label class="qf__field"><span>Phone</span><input name="phone" type="tel" required autocomplete="tel" inputmode="tel" /></label>
      <label class="qf__field"><span>Email <em>optional</em></span><input name="email" type="email" autocomplete="email" /></label>
    </div>
    <label class="qf__field">
      <span>How did you hear about us? <em>optional</em></span>
      <select name="source">
        <option value="">Choose one</option>
        {LEADS.sources.map((x) => <option>{x}</option>)}
      </select>
    </label>
    <label class="qf__field"><span>Tell us about the property <em>optional</em></span><textarea name="message" rows="3" placeholder="Size, what you have now, and what you want handled"></textarea></label>
    <div class="qf__row">
      <button class="qf__back" type="button">Back</button>
      <button class="btn primary qf__send" type="submit">Send my request</button>
    </div>
  </fieldset>

  <p class="qf__msg small" role="status" aria-live="polite"></p>
  <p class="fine muted qf__fine">We use this to answer you and nothing else. Prefer to talk? Call or text <a href={BRAND.phoneHref} data-loc="form">{BRAND.phone}</a>.</p>
</form>

<script is:inline>
  (function () {
    var f = document.getElementById('qf');
    if (!f || f.dataset.on) return;
    f.dataset.on = '1';
    var one = f.querySelector('[data-step="1"]'), two = f.querySelector('[data-step="2"]');
    var msg = f.querySelector('.qf__msg'), send = f.querySelector('.qf__send');
    two.hidden = true;
    function clear() { msg.textContent = ''; msg.className = 'qf__msg small'; }
    function track(name, params) { if (window.campTrack) window.campTrack(name, params); }
    var started = false;
    function start() { if (!started) { started = true; track('estimate_start', { form_page: location.pathname }); } }
    f.addEventListener('focusin', start);
    f.addEventListener('change', start);
    f.querySelector('.qf__next').addEventListener('click', function () {
      clear(); one.hidden = true; two.hidden = false; two.querySelector('input[name=name]').focus();
      track('estimate_step', { step: 2, form_page: location.pathname });
    });
    f.querySelector('.qf__back').addEventListener('click', function () {
      clear(); two.hidden = true; one.hidden = false; one.querySelector('input').focus();
    });
    /* Enter in step 1 means Next, including the Go key on a phone. */
    one.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && e.target.tagName !== 'BUTTON') { e.preventDefault(); f.querySelector('.qf__next').click(); }
    });
    function call(text) {
      msg.innerHTML = text + ' <a href="' + f.dataset.tel + '">' + f.dataset.phone + '</a>.';
    }
    /* An ad click or tagged link, kept 90 days by Tracking. */
    function tags() { try { return JSON.parse(decodeURIComponent((document.cookie.match(/(?:^|;\s*)camp_src=([^;]+)/) || [])[1] || '{}')) || {}; } catch (err) { return {}; } }
    function source(picked, t) {
      if (picked) return picked;
      var u = String(t.utm_source || '').toLowerCase();
      if (t.gclid || t.gbraid || t.wbraid || /google/.test(u)) return 'Google';
      if (/facebook|^fb$|instagram|^ig$|meta/.test(u)) return 'Facebook';
      return 'Other';
    }
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      clear();
      if (location.hostname.replace(/^www\./, '') !== f.dataset.host) { call('Online requests open when this site goes live. For now, call or text us at'); return; }
      var d = new FormData(f), picked = d.getAll('services');
      if (d.get('botcheck')) return;
      if ((String(d.get('phone')).match(/\d/g) || []).length < 10) { msg.textContent = 'Please check the phone number, so we can reach you.'; msg.classList.add('is-bad'); f.querySelector('input[name=phone]').focus(); return; }
      if (d.get('other_service')) picked.push(d.get('other_service'));
      var map = {}; try { map = JSON.parse(f.dataset.intake); } catch (err) {}
      var name = String(d.get('name') || '').trim().split(/\s+/), t = tags(), kind = String(d.get('property_type') || '');
      var town = String(d.get('town') || '').trim(), note = String(d.get('message') || '').trim();
      var lines = [
        'Website estimate request (' + location.pathname + ')',
        'Services: ' + (picked.join(', ') || 'Not chosen'),
        'Property: ' + (kind || 'Not chosen'),
        town ? 'Town: ' + town : '',
        note ? 'Message: ' + note : '',
        t.gclid ? 'Google Ads click: ' + t.gclid : '',
        t.utm_campaign ? 'Campaign: ' + t.utm_campaign : '',
      ].filter(Boolean);
      var o = {
        first_name: name[0] || '',
        last_name: name.slice(1).join(' '),
        phone: String(d.get('phone')),
        email: String(d.get('email') || ''),
        type: kind === 'A home' ? 'Residential' : 'Commercial',
        contact_method: 'Phone',
        address: town,
        service: (picked[0] && map[picked[0]]) || 'Other',
        notes: lines.join('\n'),
        source: source(String(d.get('source') || ''), t),
      };
      if (!o.email) delete o.email;
      if (!o.address) delete o.address;
      send.disabled = true; send.textContent = 'Sending';
      fetch(f.getAttribute('action'), { method: 'POST', credentials: 'omit', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(o) })
        .then(function (r) { if (!r.ok) throw new Error('status ' + r.status); return r.json().catch(function () { return {}; }); })
        .then(function (j) {
          if (j && j.success === false) throw new Error('rejected');
          /* counted on the thank-you page, once; nothing personal goes to Google */
          try { sessionStorage.setItem('hd_lead', JSON.stringify({ lead_source: d.get('lead_source') || 'estimate_form', services: picked.join(', ') || 'Not chosen', town: town, form_page: location.pathname })); } catch (err) {}
          location.href = f.dataset.thanks;
        })
        .catch(function () {
          send.disabled = false; send.textContent = 'Send my request';
          call('That did not go through. Please call or text us at');
          msg.classList.add('is-bad');
          track('estimate_error', { form_page: location.pathname });
        });
    });
  })();
</script>

<style>
  .qf {
    display: grid;
    gap: 1rem;
  }

  .qf__step {
    display: grid;
    gap: 1rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .qf__step[hidden] {
    display: none;
  }

  .qf__legend {
    display: grid;
    gap: 0.15rem;
    margin-bottom: 0.25rem;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 720;
    letter-spacing: -0.02em;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.012em;
  }

  .qf__legend .fine {
    font-family: var(--font);
    letter-spacing: 0;
  }

  .qf__chips,
  .qf__kind {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .qf__kind {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .qf__chip {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .qf__chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .qf__chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid #8a8676;
    border-radius: var(--r-sm);
    background: var(--white);
    font-size: 0.9375rem;
    font-weight: 540;
    transition:
      background-color 0.16s var(--ease),
      border-color 0.16s var(--ease),
      color 0.16s var(--ease);
  }

  .qf__chip:hover span {
    border-color: var(--action);
  }

  .qf__chip input:checked + span {
    border-color: var(--action);
    background: var(--action);
    color: #fff;
  }

  .qf__chip input:focus-visible + span {
    outline: 2px solid var(--action);
    outline-offset: 2px;
  }

  .qf__field {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 560;
  }

  .qf__field em {
    font-style: normal;
    font-weight: 400;
    color: var(--muted);
  }

  .qf__field input,
  .qf__field select,
  .qf__field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.8rem;
    border: 1px solid #8a8676;
    border-radius: var(--r-sm);
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
  }

  .qf ::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .qf__field textarea {
    resize: vertical;
  }

  .qf__field :focus-visible {
    outline: 2px solid var(--action);
    outline-offset: 1px;
    border-color: var(--action);
  }

  .qf__two {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 34rem) {
    .qf__two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .qf__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .qf__back {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--muted);
    font-weight: 560;
    text-decoration: underline;
    cursor: pointer;
  }

  .qf__next,
  .qf__send {
    justify-self: start;
    min-width: 11rem;
  }

  @media (max-width: 29.99rem) {
    .qf__next {
      justify-self: stretch;
    }

    .qf__row .qf__send {
      flex: 1;
    }
  }

  .qf__msg:empty {
    display: none;
  }

  .qf__msg {
    font-weight: 560;
  }

  .qf__msg.is-bad {
    padding: 0.7rem 0.85rem;
    border-left: 3px solid #a12b1f;
    background: #fbeeeb;
    color: #6f1c13;
  }

  .qf__fine a {
    font-weight: 600;
  }
</style>
