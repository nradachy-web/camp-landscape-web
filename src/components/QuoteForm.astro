---
/* The estimate request: two short steps, then a real result. It posts JSON to
   CAMP's own lead intake in WordPress (/wp-json/cmp/v1/leads, Sarah's system),
   so a request lands where the office already works, and only shows success
   when that answers OK. The intake is same origin only, so it sends on
   camplandscape.com; anywhere else (the preview) or on any failure it says so
   and gives the phone number, because a form that pretends to send is how
   leads get lost.

   Backup lane: when the intake does not answer OK the same request goes to
   ops@ by Web3Forms with the intake's error in the subject, for hand entry.
   It was added 2026-11-10 because the intake refused anyone who was not
   already a customer; that was a bug in its /leads handler and is fixed as of
   2026-11-11, so the backup is now what it sounds like -- a net for when the
   office system is down, not the normal path.

   The address is a real one: this page asks Google Places for suggestions and
   draws them itself, then takes a latitude and longitude from the one picked,
   so a request arrives ready to map and schedule instead of naming only a
   town. Not Google's own widget -- see the note by that code for why. The key
   is not in this repo (this repo is public); the page asks WordPress for it on
   first use, and with no key the field is an ordinary text box that still
   sends what was typed.

   The intake takes one service from a fixed list, so the first service picked
   decides it (by its group) and every pick, the property, address, message
   and page go in notes. No file uploads, so photos go by text. */
import { BRAND, FORM, LEADS } from '../data/site';
import { SERVICES } from '../data/services';
import { href } from '../lib/paths';

interface Props {
  service?: string;
  town?: string;
  /** Which property type starts selected: 0 home, 1 business, 2 community. */
  kind?: number;
}
const { service = '', town = '', kind = 0 } = Astro.props;
const id = 'qf';
/* The office's own lead form asks these, in these words, with these options,
   and the intake stores them as they arrive. Keeping the two identical means a
   lead reads the same whichever form it came through, and nothing has to be
   translated on the way in. */
const TYPES = ['Residential', 'Commercial'];
const SERVICE_OPTIONS = ['Irrigation', 'Landscaping', 'Snow/Ice Management', 'Lawn Maintenance', 'Other'];
const CONTACT_METHODS = ['Phone', 'Email', 'Text'];
const SOURCES = ['Google', 'Facebook', 'Referral', 'Return Customer', 'Other'];

/* Any service name on the site to one of the five the intake accepts, by the
   service's group. The form no longer offers these longer names, but two
   callers still speak them: a page that preselects a service, and the Send
   this plan button on /plan-your-year/, which reads this map off the form. */
const BY_GROUP = { build: 'Landscaping', care: 'Lawn Maintenance', water: 'Irrigation', winter: 'Snow/Ice Management' } as const;
const extra = ['Landscape management', 'Landscape installation', 'Irrigation installation', 'Irrigation service and repair', 'Snow and ice removal', 'Retaining walls and steps', 'Sod, seed and grading', 'Fertilizer and weed control', 'Sprinkler winterization'];
const intake: Record<string, string> = {};
for (const s of SERVICES) intake[s.name] = BY_GROUP[s.group as keyof typeof BY_GROUP] ?? 'Other';
for (const c of extra) if (!intake[c]) intake[c] = /irrigation|sprinkler/i.test(c) ? 'Irrigation' : /snow/i.test(c) ? 'Snow/Ice Management' : /management|fertilizer|weed/i.test(c) ? 'Lawn Maintenance' : 'Landscaping';

/* A page asking for a service preselects the one the intake would file it
   under. kind 0 is a home; 1 and 2 are both somebody's business. */
const startService = intake[service] || (SERVICE_OPTIONS.includes(service) ? service : '');
const startType = kind === 0 ? 'Residential' : 'Commercial';
---

<!-- novalidate, deliberately: the script below owns validation. Step 1 is
     hidden while step 2 is open, and a browser refuses to submit a form with
     an empty required field it cannot scroll to -- it blocks with "an invalid
     form control is not focusable" and no visible message, which would make
     the Send button simply stop working. The address input also turns into a
     hidden one when Places takes over, which is the same trap. The required
     attributes stay for screen readers; only the native blocking is off. -->
<form class="qf" id={id} action={LEADS.endpoint} method="POST" novalidate data-host={LEADS.host} data-thanks={href('/thank-you/')} data-tel={BRAND.phoneHref} data-phone={BRAND.phone} data-intake={JSON.stringify(intake)} data-w3={FORM.endpoint} data-key={FORM.key}>
  <input type="checkbox" name="botcheck" class="sr" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <noscript><p class="small">This form needs JavaScript. Call or text us at <a href={BRAND.phoneHref}>{BRAND.phone}</a> instead.</p></noscript>

  <fieldset class="qf__step" data-step="1">
    <legend class="qf__legend"><span class="fine muted">Step 1 of 2</span> What do you need?</legend>
    <div class="qf__group">
      <span class="qf__label">Type</span>
      <div class="qf__kind" role="radiogroup" aria-label="Type" aria-required="true">
        {
          TYPES.map((t) => (
            <label class="qf__chip">
              <input type="radio" name="type" value={t} checked={t === startType} required />
              <span>{t}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="qf__group">
      <span class="qf__label">Service needed</span>
      <div class="qf__chips" role="radiogroup" aria-label="Service needed" aria-required="true">
        {
          SERVICE_OPTIONS.map((s) => (
            <label class="qf__chip">
              <input type="radio" name="service" value={s} checked={s === startService} required />
              <span>{s}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="qf__field">
      <label for="qf-address">Service address</label>
      <div class="qf__ac">
        {/* autocomplete=off so the browser's own address dropdown does not
            cover ours. The list is a sibling, not inside the label, because
            clicking something inside a label re-focuses the label's input. */}
        <input id="qf-address" name="address" required autocomplete="off" placeholder="Start typing your address" role="combobox" aria-expanded="false" aria-controls="qf-address-list" aria-autocomplete="list" />
        <ul class="qf__ac-list" id="qf-address-list" role="listbox" aria-label="Address suggestions" hidden></ul>
      </div>
      <input type="hidden" name="address_lat" />
      <input type="hidden" name="address_lng" />
      <input type="hidden" name="town" value={town} />
    </div>
    <label class="qf__field"><span>Additional notes <em>optional</em></span><textarea name="notes" rows="3" placeholder="Size, what you have now, and what you want handled"></textarea></label>
    <button class="btn primary qf__next" type="button">Next</button>
  </fieldset>

  <fieldset class="qf__step" data-step="2">
    <legend class="qf__legend"><span class="fine muted">Step 2 of 2</span> How do we reach you?</legend>
    <div class="qf__group">
      <span class="qf__label">Name</span>
      <div class="qf__two">
        <input name="first_name" required autocomplete="given-name" aria-label="First name" placeholder="First name" />
        <input name="last_name" required autocomplete="family-name" aria-label="Last name" placeholder="Last name" />
      </div>
    </div>
    <div class="qf__two">
      <label class="qf__field">
        <span>Phone</span>
        <span class="qf__tel">
          <span class="qf__tel-pre" aria-hidden="true">+1</span>
          <input name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="(555) 123-4567" />
        </span>
      </label>
      <label class="qf__field"><span>Email</span><input name="email" type="email" required autocomplete="email" placeholder="your@email.com" /></label>
    </div>
    <div class="qf__group">
      <span class="qf__label">Preferred contact method</span>
      <div class="qf__chips" role="radiogroup" aria-label="Preferred contact method" aria-required="true">
        {
          CONTACT_METHODS.map((m, i) => (
            <label class="qf__chip">
              <input type="radio" name="contact_method" value={m} checked={i === 0} required />
              <span>{m}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="qf__group">
      <span class="qf__label">How did you hear about us?</span>
      <div class="qf__chips" role="radiogroup" aria-label="How did you hear about us" aria-required="true">
        {
          SOURCES.map((x) => (
            <label class="qf__chip">
              <input type="radio" name="source" value={x} required />
              <span>{x}</span>
            </label>
          ))
        }
      </div>
    </div>
    <div class="qf__row">
      <button class="qf__back" type="button">Back</button>
      <button class="btn primary qf__send" type="submit">Send my request</button>
    </div>
  </fieldset>

  <p class="qf__msg small" role="status" aria-live="polite"></p>
  <p class="fine muted qf__fine">We use this to answer you and nothing else. Prefer to talk? Call or text <a href={BRAND.phoneHref} data-loc="form">{BRAND.phone}</a>.</p>
</form>

<script is:inline>
  (function () {
    var f = document.getElementById('qf');
    if (!f || f.dataset.on) return;
    f.dataset.on = '1';
    var one = f.querySelector('[data-step="1"]'), two = f.querySelector('[data-step="2"]');
    var msg = f.querySelector('.qf__msg'), send = f.querySelector('.qf__send');
    two.hidden = true;
    function clear() { msg.textContent = ''; msg.className = 'qf__msg small'; }
    function track(name, params) { if (window.campTrack) window.campTrack(name, params); }
    var started = false;
    function start() { if (!started) { started = true; track('estimate_start', { form_page: location.pathname }); } places(); }
    f.addEventListener('focusin', start);
    f.addEventListener('change', start);

    /* Address suggestions, asked for by this page rather than by Google's own
       widget, and drawn into the list below the box.
       ---
       The widget was the obvious way and it was the wrong one. Its options are
       not the old Autocomplete's: componentRestrictions and types are refused,
       the constructor throws, and the only honest thing a catch can do is put
       the plain box back -- which looks exactly like autocomplete being
       broken. Worse, it replaces our input with its own, so an address nobody
       clicked a suggestion for never reaches the form at all, and a required
       field no one can satisfy is a form that cannot be sent.
       ---
       Doing the two calls ourselves keeps our input the only thing that
       matters: whatever is typed is what gets sent, a pick merely tidies it up
       and adds the point. The key is restricted by HTTP referrer, so these
       calls work from this domain and nowhere else. One session token spans a
       run of keystrokes and the pick that ends it, which is how this is billed
       -- a new one starts after each pick. */
    var addr = f.querySelector('input[name=address]');
    var lat = f.querySelector('input[name=address_lat]');
    var lng = f.querySelector('input[name=address_lng]');
    var box = f.querySelector('#qf-address-list');
    var AC = 'https://places.googleapis.com/v1/places';
    /* A town, a county, a zip code: real places, useless as a service address.
       Businesses stay -- a property manager may know the name of a business
       park and not its number. */
    var REGIONISH = /^(political|locality|sublocality[\w]*|administrative_area_level_\d|country|postal_code[\w]*|neighborhood|route)$/;
    var key = '', token = '', items = [], at = -1, timer = 0, asked = false;

    function uuid() {
      if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = (Math.random() * 16) | 0;
        return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
      });
    }
    /* The key is not in this repo: this repo is public. WordPress holds it. */
    function places() {
      if (asked) return;
      asked = true;
      fetch('/wp-json/cmp/v1/site-config', { credentials: 'omit', headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (j) { key = (j && j.places_key) || ''; })
        .catch(function () {});
    }
    function hide() {
      box.hidden = true;
      box.innerHTML = '';
      items = []; at = -1;
      addr.setAttribute('aria-expanded', 'false');
    }
    function draw() {
      box.innerHTML = '';
      items.forEach(function (s, i) {
        var li = document.createElement('li');
        li.className = 'qf__ac-item';
        li.id = 'qf-ac-' + i;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', i === at ? 'true' : 'false');
        li.textContent = s.text;
        /* mousedown, not click: blur would close the list first. */
        li.addEventListener('mousedown', function (e) { e.preventDefault(); pick(i); });
        box.appendChild(li);
      });
      box.hidden = !items.length;
      addr.setAttribute('aria-expanded', items.length ? 'true' : 'false');
    }
    function mark(n) {
      at = n;
      [].forEach.call(box.children, function (li, i) {
        li.setAttribute('aria-selected', i === at ? 'true' : 'false');
        li.classList.toggle('is-on', i === at);
      });
      if (at >= 0) addr.setAttribute('aria-activedescendant', 'qf-ac-' + at);
      else addr.removeAttribute('aria-activedescendant');
    }
    function pick(i) {
      var s = items[i];
      if (!s) return;
      addr.value = s.text;
      var used = token;
      hide();
      /* Tidy the line into a full formatted address and take the point with
         it. If this call fails the typed line stands, which is still a real
         answer -- it just arrives without coordinates. */
      fetch(AC + '/' + encodeURIComponent(s.id) + '?fields=formattedAddress,location&sessionToken=' + encodeURIComponent(used), {
        credentials: 'omit',
        headers: { 'X-Goog-Api-Key': key },
      })
        .then(function (r) { return r.json(); })
        .then(function (p) {
          if (p && p.formattedAddress) addr.value = p.formattedAddress;
          if (p && p.location) { lat.value = p.location.latitude; lng.value = p.location.longitude; }
        })
        .catch(function () {})
        .then(function () { token = ''; });
    }
    function ask(text) {
      if (!key || text.length < 4) { hide(); return; }
      if (!token) token = uuid();
      fetch(AC + ':autocomplete', {
        method: 'POST',
        credentials: 'omit',
        headers: { 'Content-Type': 'application/json', 'X-Goog-Api-Key': key },
        body: JSON.stringify({ input: text, includedRegionCodes: ['us'], sessionToken: token }),
      })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          /* Stale answer: they have typed on since. */
          if (addr.value.trim() !== text) return;
          items = ((j && j.suggestions) || [])
            .map(function (s) { return s.placePrediction; })
            .filter(function (p) {
              return p && p.placeId && !(p.types || []).some(function (t) { return REGIONISH.test(t); });
            })
            .slice(0, 5)
            .map(function (p) { return { id: p.placeId, text: p.text && p.text.text }; })
            .filter(function (s) { return s.text; });
          at = -1;
          draw();
        })
        .catch(function () { hide(); });
    }
    if (addr && box) {
      addr.addEventListener('input', function () {
        /* Typing moves off the place that was picked, so the old point is no
           longer this address. */
        lat.value = ''; lng.value = '';
        var text = addr.value.trim();
        clearTimeout(timer);
        timer = setTimeout(function () { ask(text); }, 250);
      });
      addr.addEventListener('keydown', function (e) {
        if (box.hidden || !items.length) return;
        if (e.key === 'ArrowDown') { e.preventDefault(); mark((at + 1) % items.length); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); mark(at <= 0 ? items.length - 1 : at - 1); }
        else if (e.key === 'Enter' && at >= 0) { e.preventDefault(); pick(at); }
        else if (e.key === 'Escape') { hide(); }
      });
      addr.addEventListener('blur', function () { setTimeout(hide, 120); });
    }
    f.querySelector('.qf__next').addEventListener('click', function () {
      clear(); one.hidden = true; two.hidden = false; two.querySelector('input[name=first_name]').focus();
      track('estimate_step', { step: 2, form_page: location.pathname });
    });
    f.querySelector('.qf__back').addEventListener('click', function () {
      clear(); two.hidden = true; one.hidden = false; one.querySelector('input').focus();
    });
    /* Enter in step 1 means Next, including the Go key on a phone -- unless
       something nearer the key already dealt with it, which is how Enter on a
       highlighted address suggestion picks it instead of skipping the step. */
    one.addEventListener('keydown', function (e) {
      if (e.defaultPrevented) return;
      if (e.key === 'Enter' && e.target.tagName !== 'BUTTON') { e.preventDefault(); f.querySelector('.qf__next').click(); }
    });
    function call(text) {
      msg.innerHTML = text + ' <a href="' + f.dataset.tel + '">' + f.dataset.phone + '</a>.';
    }
    /* An ad click or tagged link, kept 90 days by Tracking. */
    function tags() { try { return JSON.parse(decodeURIComponent((document.cookie.match(/(?:^|;\s*)camp_src=([^;]+)/) || [])[1] || '{}')) || {}; } catch (err) { return {}; } }
    function source(picked, t) {
      if (picked) return picked;
      var u = String(t.utm_source || '').toLowerCase();
      if (t.gclid || t.gbraid || t.wbraid || /google/.test(u)) return 'Google';
      if (/facebook|^fb$|instagram|^ig$|meta/.test(u)) return 'Facebook';
      return 'Other';
    }
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      clear();
      if (location.hostname.replace(/^www\./, '') !== f.dataset.host) { call('Online requests open when this site goes live. For now, call or text us at'); return; }
      var d = new FormData(f);
      if (d.get('botcheck')) return;
      /* Every answer is compulsory except the notes, in the order someone
         reads them, so the first thing missing is the first thing complained
         about. Both radio groups that arrive pre-answered are still listed:
         they are only ever empty if a default is dropped later, and silently
         posting nothing would be worse than a message nobody sees. */
      var need = [
        ['type', 'Please choose residential or commercial.', 'input[name=type]'],
        ['service', 'Please choose the service you need.', 'input[name=service]'],
        ['address', 'Please add the service address.', 'input[name=address]'],
        ['first_name', 'Please add your first name.', 'input[name=first_name]'],
        ['last_name', 'Please add your last name.', 'input[name=last_name]'],
        ['phone', 'Please add a phone number, so we can reach you.', 'input[name=phone]'],
        ['email', 'Please add your email, so we can confirm.', 'input[name=email]'],
        ['contact_method', 'Please choose how you would rather be contacted.', 'input[name=contact_method]'],
        ['source', 'Please tell us how you heard about us.', 'input[name=source]'],
      ];
      function complain(text, sel) {
        msg.textContent = text;
        msg.classList.add('is-bad');
        var miss = f.querySelector(sel);
        /* Step 1's fields are hidden once you are on step 2; show it again
           rather than complaining about something nobody can see. */
        if (miss && one.contains(miss) && one.hidden) { two.hidden = true; one.hidden = false; }
        if (miss) miss.focus();
      }
      for (var n = 0; n < need.length; n++) {
        if (!String(d.get(need[n][0]) || '').trim()) { complain(need[n][1], need[n][2]); return; }
      }
      if ((String(d.get('phone')).match(/\d/g) || []).length < 10) { complain('Please check the phone number, so we can reach you.', 'input[name=phone]'); return; }
      /* Not a full address check, just the shape, so a typo does not cost the
         lead its only reply address. */
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(d.get('email')).trim())) { complain('Please check the email address.', 'input[name=email]'); return; }
      var t = tags();
      var town = String(d.get('town') || '').trim(), note = String(d.get('notes') || '').trim();
      var where = String(d.get('address') || '').trim();
      var service = String(d.get('service') || '');
      /* The answers go to the intake in its own fields. Notes carry only what
         it has nowhere to put: which page, the ad click, the campaign. */
      var lines = [
        note,
        'Website estimate request (' + location.pathname + ')',
        !where && town ? 'Town: ' + town : '',
        t.gclid ? 'Google Ads click: ' + t.gclid : '',
        t.utm_campaign ? 'Campaign: ' + t.utm_campaign : '',
      ].filter(Boolean);
      var o = {
        first_name: String(d.get('first_name') || '').trim(),
        last_name: String(d.get('last_name') || '').trim(),
        phone: String(d.get('phone')),
        email: String(d.get('email') || ''),
        type: String(d.get('type') || 'Residential'),
        contact_method: String(d.get('contact_method') || 'Phone'),
        address: where || town,
        address_lat: String(d.get('address_lat') || ''),
        address_lng: String(d.get('address_lng') || ''),
        service: service,
        notes: lines.join('\n'),
        source: source(String(d.get('source') || ''), t),
      };
      if (!o.email) delete o.email;
      if (!o.address) delete o.address;
      if (!o.address_lat) { delete o.address_lat; delete o.address_lng; }
      send.disabled = true; send.textContent = 'Sending';
      function done() {
        /* counted on the thank-you page, once; nothing personal goes to Google */
        try { sessionStorage.setItem('hd_lead', JSON.stringify({ lead_source: d.get('lead_source') || 'estimate_form', services: service || 'Not chosen', town: town, form_page: location.pathname })); } catch (err) {}
        location.href = f.dataset.thanks;
      }
      function failed() {
        send.disabled = false; send.textContent = 'Send my request';
        call('That did not go through. Please call or text us at');
        msg.classList.add('is-bad');
        track('estimate_error', { form_page: location.pathname });
      }
      /* Backup lane: the same request to ops@ by email, flagged for hand entry. */
      function backup(why) {
        if (!f.dataset.key) { failed(); return; }
        var b = {
          access_key: f.dataset.key,
          subject: 'Website estimate request: ' + o.first_name + ' ' + o.last_name + ' (' + o.type + ', ' + o.service + ') NOT in the office system',
          from_name: 'CAMP Landscape website',
          note: 'The office system did not accept this request (' + why + '). Please add it by hand.',
          name: (o.first_name + ' ' + o.last_name).trim(),
          phone: o.phone,
          email: o.email || '',
          type: o.type,
          service: o.service,
          source: o.source,
          details: o.notes,
        };
        fetch(f.dataset.w3, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(b) })
          .then(function (r) { return r.json(); })
          .then(function (j) { if (!j.success) throw new Error('rejected'); track('estimate_backup', { form_page: location.pathname }); done(); })
          .catch(failed);
      }
      fetch(f.getAttribute('action'), { method: 'POST', credentials: 'omit', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(o) })
        .then(function (r) {
          return r.json().catch(function () { return {}; }).then(function (j) {
            if (!r.ok || (j && j.success === false)) throw new Error('status ' + r.status + (j && j.code ? ' ' + j.code : ''));
            done();
          });
        })
        .catch(function (err) { backup(String((err && err.message) || 'no answer')); });
    });
  })();
</script>

<style>
  .qf {
    display: grid;
    gap: 1rem;
  }

  .qf__step {
    display: grid;
    gap: 1rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .qf__step[hidden] {
    display: none;
  }

  .qf__legend {
    display: grid;
    gap: 0.15rem;
    margin-bottom: 0.25rem;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 720;
    letter-spacing: -0.02em;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.012em;
  }

  .qf__legend .fine {
    font-family: var(--font);
    letter-spacing: 0;
  }

  .qf__chips,
  .qf__kind {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* A question whose answer is a row of chips rather than a box to type in.
     Same label type as .qf__field so the form reads as one column. */
  .qf__group {
    display: grid;
    gap: 0.45rem;
