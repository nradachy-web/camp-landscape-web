---
/* About CAMP, at the old site's address. Values are CAMP's own words from the
   old About and service pages: initiative, integrity, thoroughness, professionalism. */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Head from '../components/Head.astro';
import Photo from '../components/Photo.astro';
import Reviews from '../components/Reviews.astro';
import QuoteBand from '../components/QuoteBand.astro';
import Edge from '../components/Edge.astro';
import { BRAND } from '../data/site';
import { REVIEWS } from '../data/reviews';
import { TREE_PARTNER } from '../data/services';
import { photo } from '../data/photos';
import { heroImage } from '../lib/hero';
import { href } from '../lib/paths';
import { breadcrumbs } from '../lib/schema';

const path = '/about/';
const hero = await heroImage('team-table', { focus: 'right' });
const values = [
  { title: 'Initiative', body: 'We solve problems before they become costly: the head that is about to fail, the bed about to get away from you, the curb that needs a stake before the first storm.' },
  { title: 'Integrity', body: 'Honest advice. We only recommend plants and features that will thrive here and make sense for how the property is used, so you never pay for something it does not need.' },
  { title: 'Thoroughness', body: 'Every detail, start to finish: edges cut, clippings blown off, every zone checked, the walk salted to the door. No patches, just real fixes.' },
  { title: 'Professionalism', body: 'The polish of a big outfit with the attention you would expect from people who live here. Calls get answered, and the office follows through.' },
];
---

<Base
  title="About CAMP Landscape Management | Grand Rapids, MI"
  description="CAMP Landscape Management is a Grand Rapids landscape company owned by Chris Holmes, built on initiative, integrity and thoroughness, with a shop on Blaine Ave SE."
  path={path}
  preload={hero.preload}
  schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'About', path }])]}
>
  <Hero image={hero} kicker="About CAMP Landscape Management" title="Every property, treated **like a neighbor's.**" lede={`CAMP is a ${BRAND.city} landscape company owned by ${BRAND.owner}, working out of a shop on Blaine Ave SE across Kent County and into Ottawa County.`} crumbs={[{ name: 'About', path }]} />

  <section class="band has-edge" aria-labelledby="who-h">
    <div class="wrap two wide-left">
      <div class="stack" style="--gap:1.4rem">
        <Head id="who-h" layout="left" eyebrow="Who we are" title="Local knowledge. **Better results.**" />
        <div class="prose">
          <p>We know what works in West Michigan soil, and what turns into a costly mistake after one hard winter. Every recommendation is based on what you want and how you will actually use the property.</p>
          <p>You can hand us the whole year. We design and build the landscape, keep it up week to week, start the sprinklers in spring and blow them out in fall, and on commercial sites we plow and salt when it snows. One company, one number, whatever the season.</p>
          <p>Tree work stays in the family. Removals, trimming and stump grinding are done by our sister company, <a href={TREE_PARTNER.href} target="_blank" rel="noopener">{TREE_PARTNER.name}</a>, under the same ownership.</p>
        </div>
      </div>
      <figure>
        <div class="frame tall"><Photo id="real-shop" ratio={4 / 5} widths={[420, 640, 860]} sizes="(min-width: 60rem) 36vw, 92vw" /></div>
        <figcaption class="note cap">{photo('real-shop').caption}</figcaption>
      </figure>
    </div>
    <Edge to="ink" />
  </section>

  <section class="band ink has-edge" aria-labelledby="way-h">
    <div class="wrap">
      <Head id="way-h" eyebrow="What we stand on" title="Four words, **on every job.**" intro="They are how we answer the phone, show up for the work and treat a property like it belongs to our own neighbors, because in this community it does." />
      <ul class="grid c4 vals">
        {
          values.map((v, i) => (
            <li class="card pad val">
              <span class="val__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h3">{v.title}</h3>
              <p class="small muted">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <Edge to="paper" flip />
  </section>

  <section class="band" aria-labelledby="say-h">
    <div class="wrap">
      <Head id="say-h" eyebrow="From our clients" title="The people **we work for.**" />
      <Reviews reviews={REVIEWS.slice(0, 3)} />
      <p class="more"><a class="arrow" href={href('/commercial/')}>Commercial grounds care</a></p>
    </div>
  </section>

  <QuoteBand />
</Base>

<style>
  .val {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .val__n {
    color: var(--accent);
    font-family: var(--font-accent);
    font-size: 2rem;
    font-style: italic;
    line-height: 1;
  }

  .more {
    margin-top: 1.5rem;
  }
</style>
