---
/* The form alone, for buttons on pages without a quote band. On a phone the form
   is the first thing after the title. No sticky bar: this page IS the action. */
import Base from '../layouts/Base.astro';
import QuoteBand from '../components/QuoteBand.astro';
import { breadcrumbs } from '../lib/schema';

const path = '/get-an-estimate/';
---

<Base
  title="Get an Estimate | CAMP Landscape Management"
  description="Tell us about the property and CAMP will walk it with you. Estimates for landscaping, lawn care, irrigation and commercial snow in Grand Rapids."
  path={path}
  bare
  schema={[breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Get an estimate', path }])]}
>
  <h1 class="sr">Get an estimate from CAMP Landscape Management</h1>
  <QuoteBand from="ink" title="Tell us about the property." lede="It takes a minute. We get back to you, walk the site with you and put together a plan and an estimate." />
</Base>
