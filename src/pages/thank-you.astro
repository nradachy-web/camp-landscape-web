---
/* Where a sent form lands. Counted as a lead. Never in the sitemap. */
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { BRAND } from '../data/site';
import { href } from '../lib/paths';
---

<Base title="Thanks, we got your request | CAMP Landscape" description="Your estimate request reached CAMP Landscape Management. We will be in touch to set up a time to walk the property." path="/thank-you/" quoteHref="/get-an-estimate/" noindex bare lead>
  <PageHead eyebrow="Request received" title="Got it. **We will be in touch.**" lede="Your request is on its way to the CAMP office. Want to speed things up? Text a photo or two of the property to the number below." next="ink">
    <div class="actions">
      <a class="btn primary" href={BRAND.smsHref} data-loc="thanks-text"><Icon name="text" />Text a photo</a>
      <a class="btn ghost" href={href('/plan-your-year/')}>Plan your year</a>
    </div>
  </PageHead>
</Base>
